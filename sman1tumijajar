    function saveJurnalGuru(e) {
      if (e && typeof e.preventDefault === 'function') e.preventDefault();

      try {
        const form = document.getElementById('form-jurnal-gt');
        if (!form) throw new Error('Form jurnal tidak ditemukan.');
        if (!form.checkValidity()) {
          form.reportValidity();
          return false;
        }
        if (!guruData[currentRole]) {
          alert('Silakan pilih salah satu akun Guru Tamu terlebih dahulu.');
          return false;
        }

        const rawLogs = safeStorage.getItem('dt_jurnal_gt');
        let logs = [];
        try { logs = JSON.parse(rawLogs || '[]'); } catch (_) { logs = []; }
      
      const newEntry = {
        id: Date.now(),
        tanggal: document.getElementById('gt-tanggal').value,
        guru: guruData[currentRole].nama,
        nip: guruData[currentRole].nip,
        mapel: guruData[currentRole].mapel,
        kelas: document.getElementById('gt-kelas').value,
        jam: document.getElementById('gt-jam').value,
