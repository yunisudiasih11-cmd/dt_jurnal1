          <div>
            <span class="px-2.5 py-1 text-xs font-semibold rounded-md bg-amber-100 text-amber-800">Instrumen Lampiran Juknis Double Teaching</span>
            <h2 class="text-xl font-bold text-slate-800 mt-1">Supervisi Akademik & Kolaborasi</h2>
            <p class="text-xs text-slate-500">Diisi oleh Observer / Guru Kolaborator / Waka Kurikulum SMAN 1 Tumijajar</p>
          </div>
          <span class="text-xs text-amber-700 bg-amber-50 border border-amber-200 px-3 py-1.5 rounded-lg">
            <i class="fa-solid fa-award mr-1"></i> Standar Juknis Disdikbud Lampung 2026
          </span>
        </div>

        <form id="form-supervisi" class="mt-6 space-y-6" onsubmit="saveSupervisi(event)">
          <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <div>
              <label class="block text-xs font-semibold text-slate-600 mb-1">Observer / Guru Kolaborator</label>
              <select id="sup-observer" required class="w-full text-sm border-slate-300 rounded-lg p-2.5 border focus:ring-2 focus:ring-amber-500" onchange="autoSelectGuruTamuSup()">
                <option value="">-- Pilih Observer / Kolaborator --</option>
                <optgroup label="Unsur Kurikulum">
                  <option value="Yuni Sudiasih, S.Sos., M.Pd. (Waka Kurikulum)">Yuni Sudiasih, S.Sos., M.Pd. </option>
                </optgroup>
                <optgroup label="Bahasa Indonesia">
                  <option value="Aswarini, S.Pd. (Kode 14)">Aswarini, S.Pd. (Kode 14)</option>
                  <option value="Hendra Yogaswara, S.Pd. (Kode 26)">Hendra Yogaswara, S.Pd. (Kode 26)</option>
                </optgroup>
                <optgroup label="Bahasa Inggris">
                  <option value="Lisnawati, S.Pd. (Kode 20)">Lisnawati, S.Pd. (Kode 20)</option>
                  <option value="Wijayati, S.S., M.Pd. (Kode 17)">Wijayati, S.S., M.Pd. (Kode 17)</option>
                  <option value="Wirawati, S.Pd. (Kode 23)">Wirawati, S.Pd. (Kode 23)</option>
