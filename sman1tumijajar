        <div>
          <h1 class="text-xl font-bold leading-tight">PROGRAM DOUBLE TEACHING 2026</h1>
          <p class="text-xs text-indigo-200">SMAN 1 Tumijajar &bull; Terintegrasi Supervisi Akademik Resmi Juknis Disdikbud</p>
        </div>
      </div>
      <div class="flex items-center space-x-2">
        <span class="text-xs bg-indigo-800 px-3 py-1.5 rounded-full border border-indigo-700 text-indigo-200">
          <i class="fa-solid fa-user-check text-emerald-400 mr-1"></i> Pengembang: Yuni Sudiasih, S.Sos., M.Pd.
        </span>
      </div>
    </div>
  </header>

  <!-- NAVIGASI PERAN -->
  <nav class="bg-white border-b border-slate-200 shadow-sm no-print">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3">
      <div class="flex flex-wrap items-center justify-center gap-2">
        <button onclick="switchRole('iwan')" id="btn-iwan" class="role-btn px-4 py-2 rounded-lg font-medium text-sm transition-all flex items-center gap-2 bg-indigo-50 text-indigo-700 hover:bg-indigo-100">
          <i class="fa-solid fa-user-tie"></i> Iwan Setiawan, S.Pd.
        </button>
        <button onclick="switchRole('siti')" id="btn-siti" class="role-btn px-4 py-2 rounded-lg font-medium text-sm transition-all flex items-center gap-2 bg-slate-100 text-slate-700 hover:bg-slate-200">
          <i class="fa-solid fa-calculator"></i> Siti Mustakhlimah, S.Pd.
        </button>
        <button onclick="switchRole('ika')" id="btn-ika" class="role-btn px-4 py-2 rounded-lg font-medium text-sm transition-all flex items-center gap-2 bg-slate-100 text-slate-700 hover:bg-slate-200">
          <i class="fa-solid fa-language"></i> Ika Windya Ningrum, S.Pd.
        </button>
        <button onclick="switchRole('kolaborator')" id="btn-kolaborator" class="role-btn px-4 py-2 rounded-lg font-medium text-sm transition-all flex items-center gap-2 bg-amber-50 text-amber-800 border border-amber-300 hover:bg-amber-100">
          <i class="fa-solid fa-handshake-angle"></i> Kolaborator
        </button>
        <button onclick="switchRole('viewer')" id="btn-viewer" class="role-btn px-4 py-2 rounded-lg font-medium text-sm transition-all flex items-center gap-2 bg-emerald-50 text-emerald-800 border border-emerald-300 hover:bg-emerald-100">
          <i class="fa-solid fa-eye"></i> Pengunjung
        </button>
      </div>
    </div>
  </nav>

  <div class="app-note no-print">
    <div class="app-note-inner"><strong>Mode ChatGPT-ready</strong><span>Aplikasi ini dibuat satu-file. Logo Provinsi Lampung dan logo SMA Negeri 1 Tumijajar sudah ditanam langsung ke dalam HTML agar tetap melekat pada kop saat dicetak/Save as PDF. Data tersimpan lokal pada browser/perangkat yang digunakan.</span></div>
  </div>

  <!-- KONTEN UTAMA -->
  <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6 no-print">

    <!-- PANEL GURU TAMU -->
    <div id="panel-guru-tamu" class="space-y-6">
      <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-6">
        <div class="flex flex-col md:flex-row md:items-center justify-between pb-4 border-b border-slate-100 gap-3">
          <div>
            <span id="gt-mapel-badge" class="px-2.5 py-1 text-xs font-semibold rounded-md bg-blue-100 text-blue-800">Bahasa Indonesia</span>
            <h2 id="gt-nama-display" class="text-xl font-bold text-slate-800 mt-1">Iwan Setiawan, S.Pd.</h2>
            <p class="text-xs text-slate-500">Asal: SMAN 2 Tulang Bawang Udik &bull; Mengisi form jurnal mengajar harian</p>
          </div>
          <div class="text-right">
            <span class="text-xs text-slate-400">Status Penugasan:</span>
            <p class="text-xs font-semibold text-emerald-600"><i class="fa-regular fa-circle-check"></i> Mengajar Penuh (Double Teaching)</p>
          </div>
        </div>

        <form id="form-jurnal-gt" class="mt-6 space-y-4">
          <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
            <div>
              <label class="block text-xs font-semibold text-slate-600 mb-1">Hari & Tanggal</label>
              <input type="date" id="gt-tanggal" required class="w-full text-sm border-slate-300 rounded-lg p-2.5 border focus:ring-2 focus:ring-indigo-500">
            </div>
            <div>
              <label class="block text-xs font-semibold text-slate-600 mb-1">Kelas Sasaran</label>
              <select id="gt-kelas" required class="w-full text-sm border-slate-300 rounded-lg p-2.5 border focus:ring-2 focus:ring-indigo-500"></select>
            </div>
            <div>
              <label class="block text-xs font-semibold text-slate-600 mb-1">Jam Ke- / Alokasi</label>
              <input type="text" id="gt-jam" placeholder="Cth: Jam 1-4 (4 JP)" required class="w-full text-sm border-slate-300 rounded-lg p-2.5 border focus:ring-2 focus:ring-indigo-500">
            </div>
            <div>
              <label class="block text-xs font-semibold text-slate-600 mb-1">Guru Pendamping / Kolaborator</label>
              <select id="gt-pendamping" class="w-full text-sm border-slate-300 rounded-lg p-2.5 border focus:ring-2 focus:ring-indigo-500"></select>
            </div>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <label class="block text-xs font-semibold text-slate-600 mb-1">Materi Pokok</label>
              <input type="text" id="gt-materi" placeholder="Topik bahasan pembelajaran hari ini..." required class="w-full text-sm border-slate-300 rounded-lg p-2.5 border focus:ring-2 focus:ring-indigo-500">
            </div>
            <div>
              <label class="block text-xs font-semibold text-slate-600 mb-1">Tujuan Pembelajaran</label>
              <input type="text" id="gt-tujuan" placeholder="Capaian target pembelajaran..." required class="w-full text-sm border-slate-300 rounded-lg p-2.5 border focus:ring-2 focus:ring-indigo-500">
            </div>
          </div>

          <!-- Indikator Pembelajaran Mendalam (PM) -->
          <div class="bg-indigo-50/50 p-4 rounded-lg border border-indigo-100 space-y-2">
            <span class="text-xs font-bold text-indigo-900 block"><i class="fa-solid fa-shapes text-indigo-600 mr-1"></i> Integrasi Prinsip Pembelajaran Mendalam (PM)</span>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-3 text-xs">
              <label class="flex items-center gap-2 bg-white p-2 rounded border border-indigo-200">
                <input type="checkbox" id="pm-mindful" class="rounded text-indigo-600"> <span>Berkesadaran (Mindful)</span>
              </label>
              <label class="flex items-center gap-2 bg-white p-2 rounded border border-indigo-200">
                <input type="checkbox" id="pm-meaningful" class="rounded text-indigo-600"> <span>Bermakna (Meaningful)</span>
              </label>
              <label class="flex items-center gap-2 bg-white p-2 rounded border border-indigo-200">
                <input type="checkbox" id="pm-joyful" class="rounded text-indigo-600"> <span>Menggembirakan (Joyful)</span>
              </label>
            </div>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <label class="block text-xs font-semibold text-slate-600 mb-1">Metode & Media Pembelajaran</label>
              <textarea id="gt-metode" rows="2" placeholder="Cth: Problem Based Learning, Media Quizizz, LKPD Kasus..." class="w-full text-sm border-slate-300 rounded-lg p-2 border focus:ring-2 focus:ring-indigo-500"></textarea>
            </div>
            <div>
              <label class="block text-xs font-semibold text-slate-600 mb-1">Refleksi, Respon Siswa & Kendala</label>
              <textarea id="gt-refleksi" rows="2" placeholder="Catatan keaktifan siswa, kendala dan ide solusinya..." class="w-full text-sm border-slate-300 rounded-lg p-2 border focus:ring-2 focus:ring-indigo-500"></textarea>
            </div>
          </div>

          <div class="flex justify-end pt-3">
            <button type="button" id="btn-simpan-jurnal" class="bg-indigo-600 hover:bg-indigo-700 text-white font-medium px-5 py-2 rounded-lg text-sm transition-all shadow flex items-center gap-2">
              <i class="fa-solid fa-floppy-disk"></i> Simpan & Siapkan Dokumen Cetak
            </button>
          </div>
          <div id="jurnal-save-status" class="hidden mt-3 rounded-lg border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm font-medium text-emerald-800">Jurnal berhasil disimpan.</div>
        </form>
      </div>
    </div>

    <!-- PANEL KOLABORATOR -->
    <div id="panel-kolaborator" class="hidden space-y-6">
      <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-6">
