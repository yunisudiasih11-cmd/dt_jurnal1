      const panelViewer = document.getElementById('panel-viewer');
      const btnHapus = document.getElementById('btn-hapus-data');

      if (role === 'iwan' || role === 'siti' || role === 'ika') {
        panelGt.classList.remove('hidden');
        panelKolab.classList.add('hidden');
        panelViewer.classList.add('hidden');
        btnHapus.classList.remove('hidden');
