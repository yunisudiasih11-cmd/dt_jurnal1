    // CETAK HARUS DIPANGGIL LANGSUNG dari klik/submit pengguna.
    // Jangan gunakan await/setTimeout sebelum window.print(), karena Chrome/Edge
    // dapat memblokir dialog cetak jika user-gesture sudah terputus.
    function printPreparedArea() {
      const printArea = document.getElementById('print-area');
      if (!printArea) return false;
      printArea.classList.remove('hidden');

      // Paksa browser menghitung layout dan mengakses gambar sebelum print.
      const imgs = printArea.querySelectorAll('img');
      imgs.forEach(img => {
        img.style.visibility = 'visible';
        img.style.display = 'block';
        img.style.opacity = '1';
      });
      void printArea.offsetHeight;
      imgs.forEach(img => void img.offsetWidth);

      try {
        window.print();
        return true;
      } catch (err) {
        console.error('Gagal membuka dialog cetak:', err);
        alert('Dokumen sudah disiapkan, tetapi dialog cetak diblokir browser. Silakan klik tombol Cetak Jurnal pada tabel rekap.');
        return false;
      }
    }

