        refleksi: document.getElementById('gt-refleksi').value || '-',
        pm: [
          document.getElementById('pm-mindful').checked ? 'Mindful' : '',
          document.getElementById('pm-meaningful').checked ? 'Meaningful' : '',
          document.getElementById('pm-joyful').checked ? 'Joyful' : ''
        ].filter(Boolean).join(', ') || 'Standar'
      };

      logs.push(newEntry);
      safeStorage.setItem('dt_jurnal_gt', JSON.stringify(logs));
      renderTables();

      // Siapkan area cetak terlebih dahulu agar tombol tetap bekerja pada preview/sandbox browser.
      prepareJurnalGuruPrint(newEntry.id);

      const status = document.getElementById('jurnal-save-status');
      if (status) {
        status.textContent = 'Jurnal berhasil disimpan. Dokumen cetak sudah disiapkan.';
        status.classList.remove('hidden');
        setTimeout(() => status.classList.add('hidden'), 5000);
      }

      // Buka dialog cetak langsung dari aksi submit agar tidak diblokir browser.
      printPreparedArea();

      form.reset();
