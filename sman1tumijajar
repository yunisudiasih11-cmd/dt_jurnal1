    function clearDataConfirm() {
      if (confirm('Apakah Anda yakin ingin mengosongkan seluruh riwayat rekaman jurnal dan supervisi ini?')) {
        safeStorage.removeItem('dt_jurnal_gt');
        safeStorage.removeItem('dt_jurnal_supervisi');
        renderTables();
      }
    }

    function exportDataJSON() {
      const data = {
        jurnal_guru_tamu: JSON.parse(safeStorage.getItem('dt_jurnal_gt') || '[]'),
        supervisi_akademik: JSON.parse(safeStorage.getItem('dt_jurnal_supervisi') || '[]')
      };
      const blob = new Blob([JSON.stringify(data, null, 2)], { type: 'application/json' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `Rekap_Supervisi_Double_Teaching_SMAN1Tumijajar_${new Date().toISOString().split('T')[0]}.json`;
      document.body.appendChild(a);
      a.click();
      a.remove();
      setTimeout(() => URL.revokeObjectURL(url), 500);
    }
  </script>
